# =============================================================================
# EVENT OS — Environment Configuration Template
# =============================================================================
# Copy this file to .env in the root directory:
#   cp .env.example .env
# Fill in your Supabase, JWT, and SMTP credentials.
# NEVER commit the actual .env file to Git!
# =============================================================================

# -----------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT & SECRETS
# -----------------------------------------------------------------------------
# Current execution mode ('development' | 'production' | 'test')
NODE_ENV=development

# Secret key used for signing and verifying JSON Web Tokens (min 32 characters recommended)
JWT_SECRET=super_secret_jwt_key_for_event_os_2026_production_grade

# JWT validity duration (e.g. '7d', '24h', '30d')
JWT_EXPIRES_IN=7d

# Secret key used for HMAC-SHA256 signature on QR check-in codes
QR_SIGNING_SECRET=super_secret_jwt_key_for_event_os_2026_production_grade

# -----------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL CONFIGURATION
# -----------------------------------------------------------------------------
# Your Supabase Project API URL (Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co

# Supabase Public Anon Key (for public / client queries if needed)
SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase Service Role Secret Key (Required for elevated backend operations & bypass RLS)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# PostgreSQL Direct Connection String (Required for running database migrations in scripts/)
DATABASE_URL=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# 3. EMAIL (SMTP) CONFIGURATION (Nodemailer in Auth Service)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@eventos.com
SMTP_PASSWORD=your_smtp_app_password
SMTP_SECURE=false
EMAIL_FROM="Event OS" <noreply@eventos.com>

# -----------------------------------------------------------------------------
# 4. MICROSERVICE LISTENING PORTS (Local Host Ports)
# -----------------------------------------------------------------------------
PORT_GATEWAY=8000
PORT_AUTH=8001
PORT_EVENT=8002
PORT_TEAM=8003
PORT_TICKET=8004
PORT_CHECKIN=8005
PORT_ANNOUNCEMENT=8006
PORT_NOTIFICATION=8007

# -----------------------------------------------------------------------------
# 5. SERVICE URLS (API Gateway Proxy Targets & Inter-Service Communication)
# -----------------------------------------------------------------------------
# In local development: use localhost ports
# In Docker Compose: use container DNS names (e.g. http://auth-service:8001)
API_GATEWAY_URL=http://localhost:8000
AUTH_SERVICE_URL=http://localhost:8001
EVENT_SERVICE_URL=http://localhost:8002
TEAM_SERVICE_URL=http://localhost:8003
TICKET_SERVICE_URL=http://localhost:8004
CHECKIN_SERVICE_URL=http://localhost:8005
ANNOUNCEMENT_SERVICE_URL=http://localhost:8006
NOTIFICATION_SERVICE_URL=http://localhost:8007
