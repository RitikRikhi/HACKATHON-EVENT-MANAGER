{
  "openapi": "3.0.3",
  "info": {
    "title": "Event OS Microservices Backend API",
    "description": "Production-ready OpenAPI 3.0 specification for the Event OS event management ecosystem.",
    "version": "1.0.0",
    "contact": {
      "name": "Event OS Core Engineering Team",
      "email": "support@eventos.internal"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Local API Gateway Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Provide standard Bearer JWT token generated via /api/auth/login or /api/auth/register"
      }
    },
    "schemas": {
      "ApiResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "message": { "type": "string", "example": "Operation completed successfully" },
          "data": { "type": "object" }
        },
        "required": ["success", "message", "data"]
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "message": { "type": "string", "example": "Invalid credentials provided" },
          "error": { "type": "string", "example": "UNAUTHORIZED" },
          "details": { "type": "object" }
        },
        "required": ["success", "message"]
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "example": "Alice Engineer" },
          "email": { "type": "string", "format": "email", "example": "alice@eventos.internal" },
          "role": { "type": "string", "enum": ["USER", "PARTICIPANT", "TEAM_LEAD", "ADMIN", "SUPER_ADMIN"], "example": "PARTICIPANT" },
          "phone": { "type": "string", "nullable": true },
          "profileImage": { "type": "string", "nullable": true },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "Event": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "example": "National AI Hackathon 2026" },
          "description": { "type": "string" },
          "eventType": { "type": "string", "enum": ["HACKATHON", "COMPETITION", "FEST", "CONFERENCE", "WORKSHOP", "SEMINAR", "OTHER"] },
          "venue": { "type": "string", "example": "Tech Innovation Hub, Hall 4" },
          "startDate": { "type": "string", "format": "date-time" },
          "endDate": { "type": "string", "format": "date-time" },
          "capacity": { "type": "integer", "example": 250 },
          "status": { "type": "string", "enum": ["DRAFT", "PUBLISHED", "UPCOMING", "ONGOING", "COMPLETED", "CANCELLED"] },
          "joinCode": { "type": "string", "example": "AIHACK26" }
        }
      },
      "Team": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "example": "Neural Navigators" },
          "description": { "type": "string" },
          "eventId": { "type": "string", "format": "uuid" },
          "team_code": { "type": "string", "example": "NN-8492" },
          "status": { "type": "string", "enum": ["ACTIVE", "COMPLETED", "DISBANDED"] }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Gateway health status",
        "responses": {
          "200": {
            "description": "Gateway is healthy and operational",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } }
          }
        }
      }
    },
    "/api/system/status": {
      "get": {
        "summary": "System wide service status check",
        "responses": {
          "200": {
            "description": "Status of gateway, microservices, and database",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } }
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "summary": "Register a new user account",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string", "example": "Alice Engineer" },
                  "email": { "type": "string", "format": "email", "example": "alice@example.com" },
                  "password": { "type": "string", "format": "password", "example": "Password123!" },
                  "role": { "type": "string", "enum": ["USER", "PARTICIPANT", "TEAM_LEAD", "ADMIN"], "default": "USER" },
                  "phone": { "type": "string" }
                },
                "required": ["name", "email", "password"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "User created successfully", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } },
          "400": { "description": "Validation error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } },
          "409": { "description": "Email already exists", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Authenticate user and return JWT",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string", "format": "email", "example": "alice@example.com" },
                  "password": { "type": "string", "format": "password", "example": "Password123!" }
                },
                "required": ["email", "password"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login successful", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } },
          "401": { "description": "Invalid email or password", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "summary": "Get authenticated user profile",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Authenticated user profile", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } }
        }
      }
    },
    "/api/events": {
      "get": {
        "summary": "List events",
        "parameters": [
          { "name": "eventType", "in": "query", "schema": { "type": "string" } },
          { "name": "status", "in": "query", "schema": { "type": "string" } },
          { "name": "search", "in": "query", "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": {
          "200": { "description": "List of events", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      },
      "post": {
        "summary": "Create new event",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "venue": { "type": "string" },
                  "startDate": { "type": "string", "format": "date-time" },
                  "endDate": { "type": "string", "format": "date-time" },
                  "capacity": { "type": "integer" },
                  "eventType": { "type": "string", "default": "HACKATHON" }
                },
                "required": ["name", "venue", "startDate", "endDate", "capacity"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Event created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      }
    },
    "/api/events/{id}/register": {
      "post": {
        "summary": "Register participant for event",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "college": { "type": "string" },
                  "skills": { "type": "array", "items": { "type": "string" } },
                  "consent": { "type": "boolean", "default": true },
                  "lookingForTeam": { "type": "boolean", "default": false }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Successfully registered", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } },
          "409": { "description": "Already registered or event capacity full", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } }
        }
      }
    },
    "/api/teams": {
      "get": {
        "summary": "List teams for event",
        "parameters": [
          { "name": "eventId", "in": "query", "required": false, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "List of teams", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      },
      "post": {
        "summary": "Create team",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string", "example": "Code Ninjas" },
                  "description": { "type": "string" },
                  "eventId": { "type": "string", "format": "uuid" }
                },
                "required": ["name", "eventId"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Team created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      }
    },
    "/api/teams/join": {
      "post": {
        "summary": "Request to join team via code",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "teamCode": { "type": "string", "example": "NN-8492" }
                },
                "required": ["teamCode"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Join request submitted", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      }
    },
    "/api/tickets": {
      "post": {
        "summary": "Book / generate event ticket",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "eventId": { "type": "string", "format": "uuid" }
                },
                "required": ["eventId"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Ticket created with QR payload", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      }
    },
    "/api/checkin/scan": {
      "post": {
        "summary": "Verify QR scan at venue checkpoint",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "qrString": { "type": "string" },
                  "eventId": { "type": "string", "format": "uuid" },
                  "type": { "type": "string", "enum": ["CHECKIN", "LUNCH", "DINNER", "SWAG"], "default": "CHECKIN" },
                  "idempotencyKey": { "type": "string" }
                },
                "required": ["qrString", "eventId"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Scan verified successfully", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } },
          "409": { "description": "Participant already scanned for this checkpoint", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } }
        }
      }
    },
    "/api/helpdesk": {
      "post": {
        "summary": "Create helpdesk support ticket",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "category": { "type": "string", "enum": ["MENTOR", "TECHNICAL", "FOOD", "FACILITIES", "WIFI", "SAFETY", "HARASSMENT"] },
                  "description": { "type": "string" }
                },
                "required": ["category", "description"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Helpdesk ticket created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      }
    },
    "/api/announcements": {
      "get": {
        "summary": "List announcements",
        "parameters": [
          { "name": "eventId", "in": "query", "schema": { "type": "string", "format": "uuid" } },
          { "name": "priority", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Announcements list", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      },
      "post": {
        "summary": "Broadcast announcement",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": { "type": "string" },
                  "content": { "type": "string" },
                  "priority": { "type": "string", "enum": ["LOW", "NORMAL", "HIGH", "URGENT", "CRITICAL"], "default": "NORMAL" },
                  "pinned": { "type": "boolean", "default": false },
                  "eventId": { "type": "string", "format": "uuid" }
                },
                "required": ["title", "content"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Announcement broadcasted", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      }
    },
    "/api/submissions": {
      "post": {
        "summary": "Submit team project",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "repoUrl": { "type": "string", "format": "uri" },
                  "demoUrl": { "type": "string", "format": "uri" },
                  "description": { "type": "string" },
                  "lock": { "type": "boolean", "default": false }
                },
                "required": ["repoUrl"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Project submitted", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      }
    },
    "/api/results": {
      "get": {
        "summary": "Get published event results",
        "parameters": [
          { "name": "eventId", "in": "query", "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "Results data", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      }
    },
    "/api/notifications": {
      "get": {
        "summary": "Get user notification inbox",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Notification items", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      }
    }
  }
}
