            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"TECHNICAL\",\n  \"description\": \"Power strip at our desk is not supplying power.\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/helpdesk", "host": ["{{base_url}}"], "path": ["api", "helpdesk"] }
