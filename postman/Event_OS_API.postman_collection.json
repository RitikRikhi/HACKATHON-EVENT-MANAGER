{
  "info": {
    "name": "Event OS API Collection",
    "description": "Comprehensive Postman test collection for the Event OS Microservices Backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register Participant",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 Created', function() { pm.response.to.have.status(201); });",
                  "const res = pm.response.json();",
                  "if (res.data && res.data.token) { pm.environment.set('participant_token', res.data.token); pm.environment.set('auth_token', res.data.token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Participant\",\n  \"email\": \"alice_{{$timestamp}}@eventos.test\",\n  \"password\": \"Password123!\",\n  \"role\": \"PARTICIPANT\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/register", "host": ["{{base_url}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Register Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 Created', function() { pm.response.to.have.status(201); });",
                  "const res = pm.response.json();",
                  "if (res.data && res.data.token) { pm.environment.set('admin_token', res.data.token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Lead Organizer\",\n  \"email\": \"admin_{{$timestamp}}@eventos.test\",\n  \"password\": \"AdminPassword123!\",\n  \"role\": \"ADMIN\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/register", "host": ["{{base_url}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Get Authenticated User Profile (GET /me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }],
            "url": { "raw": "{{base_url}}/api/auth/me", "host": ["{{base_url}}"], "path": ["api", "auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "2. Events",
      "item": [
        {
          "name": "Create Event",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 Created', function() { pm.response.to.have.status(201); });",
                  "const res = pm.response.json();",
                  "if (res.data && res.data.id) { pm.environment.set('eventId', res.data.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Global Hackathon 2026\",\n  \"venue\": \"Innovation Hall, San Francisco\",\n  \"startDate\": \"2026-11-01T09:00:00.000Z\",\n  \"endDate\": \"2026-11-03T18:00:00.000Z\",\n  \"capacity\": 300,\n  \"eventType\": \"HACKATHON\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/events", "host": ["{{base_url}}"], "path": ["api", "events"] }
          }
        },
        {
          "name": "List Events",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/events", "host": ["{{base_url}}"], "path": ["api", "events"] }
          }
        },
        {
          "name": "Publish Event",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": { "raw": "{{base_url}}/api/events/{{eventId}}/publish", "host": ["{{base_url}}"], "path": ["api", "events", "{{eventId}}", "publish"] }
          }
        }
      ]
    },
    {
      "name": "3. Registration & LFT",
      "item": [
        {
          "name": "Register for Event",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{participant_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"college\": \"Stanford University\",\n  \"skills\": [\"React\", \"TypeScript\", \"AI\"],\n  \"consent\": true,\n  \"lookingForTeam\": true\n}"
            },
            "url": { "raw": "{{base_url}}/api/events/{{eventId}}/register", "host": ["{{base_url}}"], "path": ["api", "events", "{{eventId}}", "register"] }
          }
        },
        {
          "name": "View Looking For Team Pool",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/events/{{eventId}}/looking-for-team", "host": ["{{base_url}}"], "path": ["api", "events", "{{eventId}}", "looking-for-team"] }
          }
        }
      ]
    },
